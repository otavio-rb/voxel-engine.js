    "gen:palette": "node scripts/build-geo-palette.mjs",
    "prebuild": "npm run gen:api"
  },
  "devDependencies": {
    "jpeg-js": "^0.4.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  },
