{
  "name": "voxel.js",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:boundary": "node scripts/check-engine-boundary.mjs",
    "check:shared": "node scripts/check-shared-chunk-writes.mjs",
    "check": "npm run typecheck && npm run check:boundary && npm run check:shared",
    "server": "node examples/game/server/index.js",
    "gen:palette": "node scripts/build-geo-palette.mjs"
  },
  "devDependencies": {
    "jpeg-js": "^0.4.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  },
  "dependencies": {
    "simplex-noise": "^4.0.3",
    "three": "^0.169.0"
  }
}
