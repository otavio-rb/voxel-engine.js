{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@voxel/engine": ["engine/index.ts"],
      "@voxel/engine/worker": ["engine/worker.ts"],
      "@voxel/engine/chunk-worker": ["engine/chunk-worker.ts"]
    }
  },
  "include": ["engine", "game"]
}
